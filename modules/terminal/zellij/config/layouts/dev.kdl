layout {
    pane split_direction="vertical" {
        pane {
            name "Git"
            command "lazygit"
            args "-sm" "full"
            size "20%"
        }
        pane split_direction="horizontal" {
            pane {
                name "Editor"
                command "hx"
                args "."
                focus true
                size "80%"
            }
            pane {
                name "Terminal"
            }
        }
    }
}

